# Optional token required only for mutating actions such as restarting services.
# Generate a long random value before enabling actions.
MANAGER_API_TOKEN=change-me

# Comma-separated Docker container names that the manager is allowed to control.
MANAGER_ALLOWED_SERVICES=jellyfin,gluetun,deluge,sonarr,radarr,prowlarr,bazarr,jellyseerr,tailscale,samba

# Where the media-server data root is visible to the manager.
MEDIA_ROOT=/

# Dashboard refresh interval, in seconds.
MANAGER_REFRESH_SECONDS=10

# Disk warning threshold.
DISK_WARNING_PERCENT=85
